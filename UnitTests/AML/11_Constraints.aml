            <RequiredMaxValue>3</RequiredMaxValue>
            <RequiredValue>1</RequiredValue>
            <RequiredMinValue>2</RequiredMinValue>
          </OrdinalScaledType>
        </Constraint>
      </Attribute>
    </InternalElement>
