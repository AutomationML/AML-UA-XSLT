      <Attribute Name="Direction" AttributeDataType="xs:string" RefAttributeType="AutomationMLBaseAttributeTypeLib/Direction">
        <Constraint Name="AllowedValues">
          <NominalScaledType>
            <RequiredValue>In</RequiredValue>
